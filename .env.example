# Copy to .env (or .env.local) and fill in real values. Never commit the real file.

# PostgreSQL connection string used by Prisma (app, migrations, seed).
# Local Homebrew/Postgres.app install usually needs no password:
#   postgresql://YOUR_MAC_USER@localhost:5432/flora_dev
# Docker / hosted Postgres:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/flora_dev"

# Optional. Direct (non-pooled) connection for the Prisma CLI (migrations).
# Needed only when DATABASE_URL points at a connection pooler (Neon, Supabase, PgBouncer).
# The app, the seed and admin:create do not read it: they always use DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Public origin of the storefront, without a trailing slash, e.g. https://example.com
# Leave empty until the real domain exists: canonical links, og:url, JSON-LD URLs and
# sitemap entries are omitted while it is not set.
NEXT_PUBLIC_SITE_URL=""

# Set to 1 only when the app runs behind a reverse proxy/CDN (Vercel, nginx, ...) that
# overwrites X-Forwarded-For. The admin sign-in limits then count failures per address.
# Leave unset otherwise: the header is client-controlled and the limits count per login only.
# TRUST_PROXY=1

# Product photos (Vercel Blob). On Vercel the connected store authenticates with OIDC and
# nothing needs setting. Locally run `vercel link` and `vercel env pull .env.local`, which
# writes BLOB_STORE_ID and a short-lived VERCEL_OIDC_TOKEN for the separate development store
# (flora-blob-dev), so local uploads never reach production. A read-write token works too,
# but it never expires and can change every photo in its store:
# BLOB_READ_WRITE_TOKEN=""

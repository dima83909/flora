// Flora storefront database schema.
//
// Conventions
// - Money is stored as integer minor units (kopiykas: 1 UAH = 100) in `...Minor` columns,
//   so arithmetic is exact and values serialise without Decimal conversion.
// - Ids are CUIDs; human-facing order numbers are a separate sequence.
// - Columns and tables are snake_case in Postgres, camelCase in TypeScript.
// - Some invariants Prisma cannot express (CHECK constraints, partial unique
//   indexes) are added by hand in the initial migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN

  @@map("user_role")
}

/// Stock policy of a product. "Low stock" is derived from `stock`, not stored.
enum ProductAvailability {
  /// Can be assembled from flowers on hand; ships within the same-day window
  IN_STOCK
  /// Flowers are sourced after the order; see `leadTimeDays`
  PREORDER
  /// Temporarily unavailable; still visible in the catalogue
  OUT_OF_STOCK

  @@map("product_availability")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  CANCELLED

  @@map("payment_status")
}

enum PaymentProvider {
  /// Recorded by staff (bank transfer, terminal in the studio)
  MANUAL
  CASH_ON_DELIVERY
  LIQPAY
  MONOBANK
  WAYFORPAY

  @@map("payment_provider")
}

enum DeliveryMethod {
  COURIER
  PICKUP

  @@map("delivery_method")
}

enum DiscountType {
  /// `discountValue` is a whole percentage, 1–100
  PERCENT
  /// `discountValue` is an amount in minor units
  FIXED_AMOUNT

  @@map("discount_type")
}

// ─── Customers ───────────────────────────────────────────────────────────────

/// A customer account. Authentication tables are added in the auth stage;
/// guest checkout does not require a user.
model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  phone           String?   @unique
  name            String?
  role            UserRole  @default(CUSTOMER)
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  favorites Favorite[]
  addresses Address[]
  orders    Order[]

  @@map("users")
}

/// Saved delivery address. Orders copy the address, so editing it never
/// changes past orders.
model Address {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  label          String?
  recipientName  String   @map("recipient_name")
  recipientPhone String   @map("recipient_phone")
  city           String   @default("Київ")
  street         String
  building       String
  apartment      String?
  entrance       String?
  floor          String?
  intercom       String?
  comment        String?
  /// At most one default per user (partial unique index in migration)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Favorite {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Real photo URL once available
  imageUrl    String?  @map("image_url")
  /// Transitional: illustrated placeholder descriptor used by the frontend
  illustration Json?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  /// Shown on the homepage
  isFeatured  Boolean  @default(false) @map("is_featured")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  categoryId          String              @map("category_id")
  /// One-line summary of the main stems, shown on cards
  composition         String
  /// Full stem list with quantities, shown on the product page
  stems               String[]            @default([])
  description         String
  careInstructions    String[]            @default([]) @map("care_instructions")
  /// Human-readable dimensions, e.g. "Висота 45 см, діаметр 35 см"
  size                String?
  priceMinor          Int                 @map("price_minor")
  /// Price before discount; set only when the product is on sale
  compareAtPriceMinor Int?                @map("compare_at_price_minor")
  availability        ProductAvailability @default(IN_STOCK)
  /// Units on hand; null means not tracked (assembled to order from daily stock)
  stock               Int?
  /// Days needed to source flowers; required when availability is PREORDER
  leadTimeDays        Int?                @map("lead_time_days")
  isFeatured          Boolean             @default(false) @map("is_featured")
  isPopular           Boolean             @default(false) @map("is_popular")
  isNew               Boolean             @default(false) @map("is_new")
  /// Ranking for the default "popular" sort; higher first
  popularity          Int                 @default(0)
  /// Unpublished products are hidden from the storefront
  isActive            Boolean             @default(true) @map("is_active")
  /// Transitional: illustrated placeholder descriptor used by the frontend
  illustration        Json?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  favorites  Favorite[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([isActive, popularity(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([priceMinor])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ─── Promotions ──────────────────────────────────────────────────────────────

model PromoCode {
  id               String       @id @default(cuid())
  /// Stored upper-case; normalise user input before lookup
  code             String       @unique
  description      String?
  discountType     DiscountType @map("discount_type")
  discountValue    Int          @map("discount_value")
  minOrderMinor    Int?         @map("min_order_minor")
  maxDiscountMinor Int?         @map("max_discount_minor")
  startsAt         DateTime?    @map("starts_at")
  expiresAt        DateTime?    @map("expires_at")
  /// Total redemptions allowed; null means unlimited
  usageLimit       Int?         @map("usage_limit")
  usageCount       Int          @default(0) @map("usage_count")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  orders Order[]

  @@map("promo_codes")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

/// Customer, address and pricing are snapshots taken at checkout.
model Order {
  id     String @id @default(cuid())
  /// Human-facing sequential number shown to customers
  number Int    @unique @default(autoincrement())

  /// Null for guest checkout; kept null if the account is deleted
  userId String? @map("user_id")

  customerName  String  @map("customer_name")
  customerPhone String  @map("customer_phone")
  customerEmail String? @map("customer_email")

  /// Flowers are often sent to someone else
  recipientName  String? @map("recipient_name")
  recipientPhone String? @map("recipient_phone")

  deliveryMethod    DeliveryMethod @default(COURIER) @map("delivery_method")
  /// Source address, if chosen from the saved list (reference only)
  addressId         String?        @map("address_id")
  deliveryCity      String?        @map("delivery_city")
  deliveryStreet    String?        @map("delivery_street")
  deliveryBuilding  String?        @map("delivery_building")
  deliveryApartment String?        @map("delivery_apartment")
  deliveryEntrance  String?        @map("delivery_entrance")
  deliveryFloor     String?        @map("delivery_floor")
  deliveryIntercom  String?        @map("delivery_intercom")
  deliveryZone      String?        @map("delivery_zone")
  deliveryDate      DateTime?      @map("delivery_date") @db.Date
  /// Local Kyiv time window, "HH:MM"
  deliverySlotStart String?        @map("delivery_slot_start") @db.VarChar(5)
  deliverySlotEnd   String?        @map("delivery_slot_end") @db.VarChar(5)

  /// Text for the handwritten card
  cardMessage     String? @map("card_message")
  customerComment String? @map("customer_comment")

  subtotalMinor     Int    @map("subtotal_minor")
  deliveryCostMinor Int    @default(0) @map("delivery_cost_minor")
  discountMinor     Int    @default(0) @map("discount_minor")
  totalMinor        Int    @map("total_minor")
  currency          String @default("UAH") @db.VarChar(3)

  promoCodeId String? @map("promo_code_id")
  /// Code as entered, kept even if the promo code is later removed
  promoCode   String? @map("promo_code")

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  confirmedAt DateTime? @map("confirmed_at")
  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  address   Address?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  promo     PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  payments  Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([deliveryDate])
  @@index([promoCodeId])
  @@map("orders")
}

/// Product details are copied at checkout so past orders never change.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  /// Reference only; null once the product is deleted
  productId String? @map("product_id")

  productSlug         String  @map("product_slug")
  productName         String  @map("product_name")
  productComposition  String? @map("product_composition")
  productImageUrl     String? @map("product_image_url")
  unitPriceMinor      Int     @map("unit_price_minor")
  compareAtPriceMinor Int?    @map("compare_at_price_minor")
  quantity            Int
  lineTotalMinor      Int     @map("line_total_minor")

  createdAt DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// One attempt to charge an order. Provider-agnostic; integrations fill
/// `providerPaymentId` and `rawPayload`.
model Payment {
  id                String          @id @default(cuid())
  orderId           String          @map("order_id")
  provider          PaymentProvider
  providerPaymentId String?         @map("provider_payment_id")
  status            PaymentStatus   @default(PENDING)
  amountMinor       Int             @map("amount_minor")
  currency          String          @default("UAH") @db.VarChar(3)
  failureReason     String?         @map("failure_reason")
  /// Last provider response, for reconciliation and support
  rawPayload        Json?           @map("raw_payload")
  paidAt            DateTime?       @map("paid_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  /// Payments are financial records: an order with payments cannot be deleted
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

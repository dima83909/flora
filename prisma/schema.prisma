// Flora storefront database schema.
//
// Business model: products → cart (browser) → guest order → a manager contacts the
// customer in Telegram (by the phone number in the order) to agree delivery and payment. There are no customer accounts, online
// payments or delivery calculation, so the schema has no users, payments or addresses.
//
// Conventions
// - Money is stored as integer minor units (kopiykas: 1 UAH = 100) in `...Minor` columns,
//   so arithmetic is exact and values serialise without Decimal conversion.
// - Ids are CUIDs; human-facing order numbers are a separate sequence.
// - Columns and tables are snake_case in Postgres, camelCase in TypeScript.
// - Some invariants Prisma cannot express (CHECK constraints, partial unique
//   indexes) are added by hand in the initial migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// Stock status of a product, set by a manager. Quantities are not tracked.
enum ProductAvailability {
  /// Can be assembled from flowers on hand; ships within the same-day window
  IN_STOCK
  /// Still orderable, but only a few are left
  LOW_STOCK
  /// Flowers are sourced after the order; see `leadTimeDays`
  PREORDER
  /// Temporarily unavailable; still visible in the catalogue
  OUT_OF_STOCK

  @@map("product_availability")
}

/// Order lifecycle as handled by a manager
enum OrderStatus {
  /// Placed by the customer, nobody has called yet
  NEW
  /// Manager has reached the customer
  CONTACTED
  /// Delivery, date and payment agreed
  CONFIRMED
  /// Delivered or picked up
  COMPLETED
  CANCELLED

  @@map("order_status")
}

// ─── Catalogue ───────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  /// Real photo URL once available
  imageUrl    String?  @map("image_url")
  /// Transitional: illustrated placeholder descriptor used by the frontend
  illustration Json?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  /// Shown on the homepage
  isFeatured  Boolean  @default(false) @map("is_featured")
  /// Linked from the main header navigation, in `sortOrder`
  showInNav   Boolean  @default(false) @map("show_in_nav")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Product {
  id                  String              @id @default(cuid())
  slug                String              @unique
  name                String
  categoryId          String              @map("category_id")
  /// One-line summary of the main stems, shown on cards
  composition         String
  /// Full stem list with quantities, shown on the product page
  stems               String[]            @default([])
  description         String
  careInstructions    String[]            @default([]) @map("care_instructions")
  /// Human-readable dimensions, e.g. "Висота 45 см, діаметр 35 см"
  size                String?
  priceMinor          Int                 @map("price_minor")
  /// Price before discount; set only when the product is on sale
  compareAtPriceMinor Int?                @map("compare_at_price_minor")
  availability        ProductAvailability @default(IN_STOCK)
  /// Days needed to source flowers; required when availability is PREORDER
  leadTimeDays        Int?                @map("lead_time_days")
  /// Shown in the homepage "popular bouquets" block
  isFeatured          Boolean             @default(false) @map("is_featured")
  /// "Популярне" badge; such products lead the default sort
  isPopular           Boolean             @default(false) @map("is_popular")
  /// "Новинка" badge; such products follow popular ones in the default sort
  isNew               Boolean             @default(false) @map("is_new")
  /// Tie-breaker for products added on the same day; higher first. Set by the seed only
  popularity          Int                 @default(0)
  /// Unpublished products are hidden from the storefront
  isActive            Boolean             @default(true) @map("is_active")
  /// Transitional: illustrated placeholder descriptor used by the frontend
  illustration        Json?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([isActive, popularity(sort: Desc)])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([priceMinor])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String
  alt       String
  width     Int?
  height    Int?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

/// Guest order. Delivery address, date, time, delivery cost and payment are agreed
/// in Telegram, so the order stores only what the customer typed and the goods total.
model Order {
  id     String      @id @default(cuid())
  /// Human-facing sequential number, starts at 1001
  number Int         @unique @default(autoincrement())
  status OrderStatus @default(NEW)

  customerName    String  @map("customer_name")
  /// Normalised to E.164, e.g. +380501234567
  customerPhone   String  @map("customer_phone")
  customerCity    String  @map("customer_city")
  customerComment String? @map("customer_comment")

  /// Sum of item totals, calculated on the server from database prices
  subtotalMinor Int    @map("subtotal_minor")
  currency      String @default("UAH") @db.VarChar(3)

  /// Internal note for managers; never shown to the customer
  managerNote String? @map("manager_note")

  /// Random key the checkout sends with each order, so a submission retried after a lost
  /// response returns the order already placed instead of creating a duplicate
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items OrderItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([customerPhone])
  @@map("orders")
}

/// Snapshot of a product at order time, so past orders never change when the
/// catalogue is edited and survive the product being deleted.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  /// Reference only; set to null if the product is deleted
  productId String? @map("product_id")

  productName    String @map("product_name")
  productSlug    String @map("product_slug")
  composition    String
  quantity       Int
  unitPriceMinor Int    @map("unit_price_minor")
  totalMinor     Int    @map("total_minor")

  createdAt DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Successful guest orders by client address and phone, counted to slow down order spam.
/// Holds no more than the orders table already does; rows older than a day are purged.
model OrderAttempt {
  id        String   @id @default(cuid())
  /// Null when the client address is unknown (no trusted proxy)
  ip        String?
  /// Normalised E.164 phone from the order
  phone     String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([phone, createdAt])
  @@map("order_attempts")
}

// ─── Admin ───────────────────────────────────────────────────────────────────
// Staff-only accounts for the order panel. Customers never get accounts.

/// A manager who can sign in to /admin. Created with `npm run admin:create`.
model AdminUser {
  id           String  @id @default(cuid())
  /// Lower-cased sign-in name
  login        String  @unique
  name         String
  /// scrypt hash with its parameters and salt; never the password itself
  passwordHash String  @map("password_hash")
  isActive     Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sessions AdminSession[]

  @@map("admin_users")
}

/// Server-side session. The browser holds a random token; only its SHA-256 is stored,
/// so a database leak does not yield usable cookies.
model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  adminId   String   @map("admin_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// Failed sign-in attempts, counted per login and per IP to slow down brute force
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  login     String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([login, createdAt])
  @@index([ip, createdAt])
  @@map("admin_login_attempts")
}
